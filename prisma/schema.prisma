generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  emailVerified     DateTime?
  hashedPassword    String?
  name              String?
  image             String?
  role              Role                 @default(CANDIDATE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  accountStatus     AccountStatus        @default(PENDING)
  currentStreak     Int                  @default(0)
  lastActivityDate  DateTime?
  longestStreak     Int                  @default(0)
  accounts          Account[]
  candidates        Candidate[]
  dailyGoals        DailyGoal[]
  enrollments       Enrollment[]
  lessonCompletions LessonCompletion[]
  mentorChats       MentorConversation[]
  quizAttempts      QuizAttempt[]
  sessions          Session[]
  taskExtensions    TaskExtension[]
  taskSubmissions   TaskSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  department      String
  status          JobStatus   @default(OPEN)
  priority        Priority    @default(MEDIUM)
  headcount       Int         @default(1)
  targetStartDate DateTime?
  description     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customQuestions Json?
  candidates      Candidate[]
}

model Candidate {
  id             String         @id @default(cuid())
  jobId          String
  stage          CandidateStage @default(APPLIED)
  name           String
  email          String
  phone          String?
  source         String?        @default("Website")
  expectedSalary String?
  noticePeriod   String?
  portfolioUrl   String?
  coverLetter    String?
  cvFileKey      String?
  cvFileUrl      String?
  userId         String?
  aiScore        Int?
  aiSummary      String?
  aiSkills       String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customAnswers  Json?
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])
  interviews     Interview[]
  messages       Message[]
  notes          Note[]
}

model Interview {
  id            String             @id @default(cuid())
  candidateId   String
  round         String
  interviewer   String
  interviewDate DateTime
  score         Int?
  decision      InterviewDecision?
  notes         String?
  createdAt     DateTime           @default(now())
  candidate     Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  content     String
  author      String    @default("Admin")
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Message {
  id          String    @id @default(cuid())
  candidateId String
  sender      Role
  content     String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id        String   @id @default(cuid())
  type      String   @unique
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String
  thumbnail     String?
  category      String
  difficulty    Difficulty     @default(BEGINNER)
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  enrollments   Enrollment[]
  lessons       Lesson[]
  tasks         Task[]
  quizzes       Quiz[]
}

model Lesson {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  description String?
  videoUrl    String?
  videoType   VideoType          @default(DRIVE)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
}

model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  timeLimit   Int      @default(20) // in seconds per question
  startTime   DateTime?
  endTime     DateTime?
  status      String   @default("SCHEDULED") // SCHEDULED, OPEN, CLOSED
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  text          String
  options       String   // JSON string of array
  correctOption Int      // Index of the correct option
  order         Int      @default(0)

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int?
  strikes     Int      @default(0)
  status      SubmissionStatus @default(PENDING) // PENDING, GRADED
  startedAt   DateTime @default(now())
  completedAt DateTime?

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Task {
  id          String           @id @default(cuid())
  courseId    String
  title       String
  description String
  maxMarks    Int              @default(100)
  dueDate     DateTime?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  extensions  TaskExtension[]
  submissions TaskSubmission[]
}

model TaskSubmission {
  id          String           @id @default(cuid())
  taskId      String
  userId      String
  content     String?
  linkUrl     String?
  status      SubmissionStatus @default(PENDING)
  marks       Int?
  aiMarks     Int?
  aiFeedback  String?
  feedback    String?
  submittedAt DateTime         @default(now())
  gradedAt    DateTime?
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskExtension {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  lessonId    String
  userId      String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model DailyGoal {
  id        String   @id @default(cuid())
  userId    String
  text      String
  completed Boolean  @default(false)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorConversation {
  id        String   @id @default(cuid())
  userId    String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  CANDIDATE
  STUDENT
  INSTRUCTOR
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW_1
  INTERVIEW_2
  TEST
  FINAL
  OFFER
  HIRED
  REJECTED
}

enum InterviewDecision {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum VideoType {
  DRIVE
  YOUTUBE
  EXTERNAL_LINK
}

enum SubmissionStatus {
  PENDING
  AI_GRADED
  GRADED
  RESUBMIT
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}
