generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  name           String?
  image          String?
  role           Role      @default(CANDIDATE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())

  accounts       Account[]
  sessions       Session[]
  candidates     Candidate[]

  // Learning Portal relations
  enrollments       Enrollment[]
  taskSubmissions   TaskSubmission[]
  lessonCompletions LessonCompletion[]
  dailyGoals        DailyGoal[]
  mentorChats       MentorConversation[]

  // Approval and Streaks
  accountStatus    AccountStatus @default(PENDING)
  lastActivityDate DateTime?
  currentStreak    Int           @default(0)
  longestStreak    Int           @default(0)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  department      String
  status          JobStatus @default(OPEN)
  priority        Priority  @default(MEDIUM)
  headcount       Int       @default(1)
  targetStartDate DateTime?
  description     String    @db.Text
  customQuestions Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidates Candidate[]
}

model Candidate {
  id             String         @id @default(cuid())
  jobId          String
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage          CandidateStage @default(APPLIED)
  name           String
  email          String
  phone          String?
  source         String?        @default("Website")
  expectedSalary String?
  noticePeriod   String?
  portfolioUrl   String?
  coverLetter    String?        @db.Text
  cvFileKey      String?
  cvFileUrl      String?
  customAnswers  Json?
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])

  aiScore        Int?
  aiSummary      String?        @db.Text
  aiSkills       String[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  interviews     Interview[]
  notes          Note[]
  messages       Message[]
}

model Interview {
  id            String             @id @default(cuid())
  candidateId   String
  candidate     Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  round         String
  interviewer   String
  interviewDate DateTime
  score         Int?
  decision      InterviewDecision?
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  author      String    @default("Admin")
  createdAt   DateTime  @default(now())
}

model Message {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sender      Role
  content     String    @db.Text
  createdAt   DateTime  @default(now())
}

model EmailTemplate {
  id        String   @id @default(cuid())
  type      String   @unique // NEW_APPLICATION, CONFIRMATION, INTERVIEW, OFFER, REJECTED
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════
// LEARNING PORTAL MODELS
// ═══════════════════════════════════════════

model Course {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  thumbnail   String?    // URL to course thumbnail image
  category    String     // e.g., "Web Development", "Python", "DevOps"
  difficulty  Difficulty @default(BEGINNER)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lessons       Lesson[]
  enrollments   Enrollment[]
  tasks         Task[]
  announcements Announcement[]
}

model Lesson {
  id          String    @id @default(cuid())
  courseId     String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  videoUrl    String?   // Google Drive link or external URL
  videoType   VideoType @default(DRIVE)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  completions LessonCompletion[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Task {
  id          String    @id @default(cuid())
  courseId     String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  maxMarks    Int       @default(100)
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  submissions TaskSubmission[]
}

model TaskSubmission {
  id          String           @id @default(cuid())
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String?          @db.Text  // Short note from student
  linkUrl     String?          // External link (GitHub, LinkedIn, etc.)
  status      SubmissionStatus @default(PENDING)
  marks       Int?             // Assigned marks
  aiMarks     Int?             // AI suggested marks
  aiFeedback  String?          @db.Text  // AI generated feedback
  feedback    String?          @db.Text  // Admin/Instructor feedback
  submittedAt DateTime         @default(now())
  gradedAt    DateTime?

  @@unique([taskId, userId])  // One submission per task per student
}

model LessonCompletion {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([lessonId, userId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model DailyGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  completed Boolean  @default(false)
  date      DateTime // To store which day the goal belongs to
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Json     // To store the chat history array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════

enum Role {
  ADMIN
  CANDIDATE
  STUDENT
  INSTRUCTOR
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW_1
  INTERVIEW_2
  TEST
  FINAL
  OFFER
  HIRED
  REJECTED
}

enum InterviewDecision {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum VideoType {
  DRIVE
  YOUTUBE
  EXTERNAL_LINK
}

enum SubmissionStatus {
  PENDING
  AI_GRADED
  GRADED
  RESUBMIT
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}
